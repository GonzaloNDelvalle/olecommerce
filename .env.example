# Copiá este archivo a .env y completá los valores. Nunca subas .env al repo.

# --- Base de datos (Neon) ---
DATABASE_URL=
DIRECT_URL=

# --- Auth.js (obligatorio: generalo con `npx auth secret` u `openssl rand -base64 32`) ---
AUTH_SECRET=
# Solo fuera de Vercel (ej. `next start` local o un VPS): confiar en el host de la request
# AUTH_TRUST_HOST=true

# --- Mercado Pago ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=
MP_USE_SANDBOX=false
# Vencimientos de órdenes impagas, en horas (opcionales)
MP_CHECKOUT_TTL_HOURS=24
MP_CASH_TTL_HOURS=72
BANK_TRANSFER_TTL_HOURS=72

# --- URL pública de la tienda ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cron de vencimiento de órdenes (Vercel lo envía como Bearer token) ---
CRON_SECRET=

# --- Emails (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=
# Recibe alertas de pagos a revisar y solicitudes de arrepentimiento
ADMIN_NOTIFY_EMAIL=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# --- Solo para crear el admin con `pnpm admin:create` (borrar después) ---
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
