# Copiá este archivo a .env y completá los valores. Nunca subas .env al repo.
# En Vercel: Project Settings → Environment Variables (Production y Preview).

# --- Base de datos (Neon) ---
# Conexión con pooler (runtime) y directa (migraciones)
DATABASE_URL=
DIRECT_URL=

# --- Autenticación (Better Auth) — obligatoria, mínimo 32 caracteres ---
# Generala con: openssl rand -base64 32
AUTH_SECRET=
# Opcional: URL pública si difiere de NEXT_PUBLIC_APP_URL
# BETTER_AUTH_URL=

# --- URL pública de la tienda (https://tudominio.com.ar) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Mercado Pago ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Opcional: URL pública para el webhook en desarrollo (túnel ngrok/cloudflared)
MP_WEBHOOK_URL=
MP_USE_SANDBOX=false
# Vencimiento de órdenes impagas, en horas (opcionales)
MP_CHECKOUT_TTL_HOURS=24
MP_CASH_TTL_HOURS=72
BANK_TRANSFER_TTL_HOURS=72

# --- Cron de vencimiento de órdenes (Vercel lo envía como Bearer token) ---
# Mínimo 16 caracteres: openssl rand -hex 24
CRON_SECRET=

# --- Emails (Resend) ---
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend, ej: "OL. <pedidos@tudominio.com.ar>"
EMAIL_FROM=
# Recibe alertas de pagos a revisar y solicitudes de arrepentimiento
ADMIN_NOTIFY_EMAIL=

# --- Cloudinary (fotos de productos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=olecommerce

# --- Monitoreo de errores (Sentry) — opcional ---
NEXT_PUBLIC_SENTRY_DSN=
# Para subir source maps en el build de Vercel
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Analítica — opcional (Vercel Analytics se activa desde el panel de Vercel) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Solo para crear el admin con `pnpm admin:create` (borrar después) ---
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Desarrollo: activar el límite de intentos también en local ---
# RATE_LIMIT_IN_DEV=true
